{
  "name": "implesta-website",
  "private": true,
  "type": "module",
  "description": "implesta.com: a static site built from content files, with checks that catch unintended changes.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "check:launch": "node scripts/check.mjs --launch",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/outfit": "^5.1.0",
    "@playwright/test": "1.56.1"
  }
}
